{
  "name": "pi-orch",
  "version": "0.1.0",
  "description": "Thin parent client (CLI + module) for Pi Web UI's Internal API: spawn, prompt, wait, result, verify.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valtterimelkko/pi-orch.git"
  },
  "homepage": "https://github.com/valtterimelkko/pi-orch#readme",
  "bugs": {
    "url": "https://github.com/valtterimelkko/pi-orch/issues"
  },
  "keywords": [
    "pi-web-ui",
    "orchestration",
    "agents",
    "internal-api",
    "cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pi-orch": "bin/pi-orch"
  },
  "scripts": {
    "test": "PI_ORCH_SPAWN_LEDGER=\"$(mktemp -d)/spawn-ledger.json\" node --test 'test/*.test.ts'",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
